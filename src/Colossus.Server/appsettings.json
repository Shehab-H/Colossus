{
  "ConnectionStrings": {
    "Database": "Server=127.0.0.1;Port=3306;Database=colossus;User ID=colossus;Password=colossus;Pooling=true;Allow User Variables=true"
  },
  "Database": {
    "CommandTimeoutSeconds": 30
  },
  "Scheduling": {
    "Enabled": true,
    "WorkerCount": 2
  },
  "BakeExecution": {
    "MaxTransientAttempts": 3,
    "CancellationPollMilliseconds": 500,
    "ProgressUpdateMinMilliseconds": 500,
    "RetryDelaySeconds": [2, 10]
  },
  "BakeResources": {
    "CpuCores": 0,
    "RamMb": 0
  },
  "Storage": {
    "TilesDirectory": "tiles",
    "StagingDirectory": "staging",
    "LegacyViewsDirectory": "views",
    "MediaDirectory": "media"
  },
  "ReleaseArtifacts": {
    "Provider": "file"
  },
  "ReleaseMaintenance": {
    "WorkspaceGracePeriod": "1.00:00:00"
  },
  "ClickHouse": {
    "BaseUrl": "http://localhost:8123",
    "User": "colossus",
    "Password": "colossus"
  },
  "ParquetSources": {
    "WorkDirectory": "staging/parquet-sources",
    "Providers": {
      "local": {
        "Kind": "local",
        "BaseLocation": "datasets/parquet"
      }
    }
  },
  "Trino": {
    "BaseUrl": "http://localhost:8080",
    "Catalog": "hive",
    "Schema": "default",
    "User": "colossus",
    "WorkDirectory": "staging/trino-sources",
    "MaxRetries": 3,
    "MaxPageBytes": 16777216
  },
  "FoldRouting": {
    "BudgetBytes": 32000000,
    "ForceRemote": false,
    "ViewportTiles": 12
  },
  "Rendering": {
    "PackTiles": false
  },
  "Server": {
    "ServerUrl": "http://localhost:5174",
    "WebBaseUrl": "http://localhost:5173"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
