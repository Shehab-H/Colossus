{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-bundle.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "lint": "oxlint",
    "test": "vitest run --project=unit",
    "test:storybook": "vitest run --project=storybook-light --project=storybook-dark",
    "test:all": "vitest run",
    "test:visual": "playwright test --config=playwright.config.ts",
    "test:visual:update": "playwright test --config=playwright.config.ts --update-snapshots",
    "test:browser:install": "playwright install chromium",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@deck.gl/core": "^9.3.6",
    "@deck.gl/extensions": "^9.3.6",
    "@deck.gl/layers": "^9.3.6",
    "@deck.gl/mapbox": "^9.3.10",
    "@deck.gl/react": "^9.3.6",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "apache-arrow": "^21.1.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-map-gl": "^8.1.1",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-themes": "^10.5.8",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "oxlint": "^1.71.0",
    "sass": "^1.102.0",
    "storybook": "^10.5.8",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
